{
  "manifestVersion": 5,
  "id": "com.jam.swisstype",
  "name": "SwissType",
  "version": "2.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "swisstypePanel",
      "label": { "default": "SwissType" },
      "minimumSize": { "width": 270, "height": 320 },
      "maximumSize": { "width": 800, "height": 2400 },
      "preferredDockedSize": { "width": 340, "height": 640 },
      "preferredFloatingSize": { "width": 340, "height": 640 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon.png", "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/icon.png", "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
